{
  "manifest_version": 3,
  "name": "Argus Lens: is this image real?",
  "version": "0.1.0",
  "description": "Checks images on Instagram, Reddit and anywhere else for signs of AI generation and private details, and shows the evidence on the image.",
  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*", "*://*.reddit.com/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Argus Lens settings" }
}
